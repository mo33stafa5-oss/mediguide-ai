# ---- Public (safe for the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# ---- Server only (Vercel project env vars; NEVER prefix with NEXT_PUBLIC_) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
ALLOWED_ORIGINS=https://your-app.vercel.app
# Optional: URL of the OCR worker (Docker) because Tesseract is not available on Vercel
OCR_WORKER_URL=
# Local development only (next.config.ts rewrite target for /api/*)
API_DEV_ORIGIN=http://127.0.0.1:8000
