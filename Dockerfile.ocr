# OCR worker: same FastAPI code, plus the Tesseract binary (Arabic + English) and OpenCV.
# Run on any container host (Fly.io, Render, Cloud Run, a VM). Set OCR_WORKER_TOKEN and expose /internal/ocr.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-ara tesseract-ocr-eng poppler-utils libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY backend/requirements.txt backend/requirements-ocr.txt backend/
RUN pip install --no-cache-dir -r backend/requirements-ocr.txt uvicorn==0.54.0
COPY backend backend
COPY ml/__init__.py ml/features.py ml/
COPY ml/artifacts ml/artifacts
ENV PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8080"]
